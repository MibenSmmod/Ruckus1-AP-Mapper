{
  "name": "ruckus-one-ap-mapper",
  "version": "1.3.0",
  "description": "Desktop application for visualizing RUCKUS ONE access point locations on venue floor plans",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/prebuild-check-credentials.js",
    "build": "npm run prebuild && electron-builder --mac",
    "build:mac-arm64": "npm run prebuild && electron-builder --mac dmg --arm64",
    "build:mac-x64": "npm run prebuild && electron-builder --mac dmg --x64",
    "build:dmg": "npm run prebuild && electron-builder --mac dmg --arm64 --x64",
    "build:win": "npm run prebuild && electron-builder --win --x64",
    "build:all": "npm run prebuild && electron-builder --mac dmg --arm64 --x64 && electron-builder --win --x64",
    "test": "node --test tests/ruckus.test.js"
  },
  "keywords": [
    "ruckus",
    "wifi",
    "access-point",
    "floor-plan",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/MibenSmmod/Ruckus1-AP-Mapper.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.ruckusoneapmapper.app",
    "productName": "RUCKUS One Device Mapper",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!config.json",
      "!**/config.json",
      "!.env",
      "!.env.*",
      "!credentials.json",
      "!scripts/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
