{
  "name": "ruckus-one-ap-mapper",
  "version": "1.0.0",
  "description": "Desktop application for visualizing Ruckus ONE access point locations on venue floor plans",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ruckus",
    "wifi",
    "access-point",
    "floor-plan",
    "visualization"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.ruckusoneapmapper.app",
    "productName": "Ruckus One AP Mapper",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
